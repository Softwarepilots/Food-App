# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real `.env` file.

# --- Django core -------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (Supabase Postgres) --------------------------------------
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DB_SSL_MODE=require
DB_CONN_MAX_AGE=60

# --- CORS ---------------------------------------------------------------
# Comma-separated list of origins allowed to call this API (mobile clients using
# native HTTP don't send an Origin header, so this mainly matters for any web client).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Leave blank to sign tokens with SECRET_KEY, or set a dedicated key.
JWT_SIGNING_KEY=

# --- Security (staging/prod only) ---------------------------------------
CSRF_TRUSTED_ORIGINS=
